MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=messenger
MYSQL_USER=aurora
MYSQL_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8000

# Optional: comma-separated public frontend origins.
# Example: https://aurora-web.up.railway.app,https://your-domain.ru
CORS_ORIGINS=

# Optional: email verification and password reset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional: when empty, uploaded files are stored on the server volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
