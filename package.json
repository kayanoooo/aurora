{
  "name": "aurora",
  "version": "1.0.0",
  "description": "Aurora — Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron": "electron .",
    "build:client": "cd client && npm run build",
    "mobile:build": "npm run build:client && npx cap sync",
    "mobile:sync": "npm run build:client && npx cap sync",
    "mobile:android": "npm run build:client && npx cap sync android",
    "mobile:android:open": "npx cap open android",
    "mobile:android:run": "npm run build:client && npx cap run android",
    "dist": "npm run build:client && electron-builder",
    "dist:linux": "npm run build:client && electron-builder --linux",
    "dist:win": "npm run build:client && electron-builder --win",
    "dist:mac": "npm run build:client && electron-builder --mac"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capawesome/capacitor-badge": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aurora.messenger",
    "productName": "Aurora",
    "asar": true,
    "files": [
      "electron/**/*",
      "client/build/**",
      "!client/build/downloads/**"
    ],
    "directories": {
      "buildResources": "client/public"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "client/public/logo512.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/public/logo512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "client/public/logo512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": {
    "name": "kayano",
    "email": "azarskovap@gmail.com"
  }
}
