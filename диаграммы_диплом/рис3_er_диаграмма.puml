users ||--o{ user_sessions           : "активные сессии"
users ||--o{ username_history        : "история имён"
users ||--o{ blocked_users           : "блокирует"

users ||--o{ messages                : "отправляет"
users ||--o{ messages                : "получает"
users ||--o{ message_reactions       : "ставит реакции"
users ||--o{ scheduled_messages      : "планирует"
users ||--o{ chat_disappear_settings : "настройки исчезания"

users ||--o{ groups                  : "создаёт"
users ||--o{ group_members           : "участник"
users ||--o{ group_messages          : "пишет в группы"
groups ||--o{ group_members          : "содержит"
groups ||--o{ group_messages         : "хранит сообщения"
group_messages ||--o{ group_message_reads : "прочтения"
group_messages ||--o{ post_views     : "просмотры канала"
groups ||--o{ group_slow_mode_timestamps : "slow mode"

users ||--o{ chat_folders            : "создаёт папки"
chat_folders ||--o{ folder_chats     : "содержит чаты"
users ||--o{ support_messages        : "обращения"

users ||--o{ polls                   : "создаёт опросы"
polls ||--o{ poll_votes              : "голоса"
users ||--o{ poll_votes              : "голосует"

users ||--o{ playlists               : "создаёт плейлисты"
playlists ||--o{ playlist_tracks     : "содержит треки"

users ||--o{ reports                 : "подаёт жалобы"
@enduml
